class _ActionTracker:
    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._open: Dict[str, Dict[str, Any]] = {}
        self._seq = 0
        self.terminal_grace_sec = float(os.getenv("AI_EVENTS_ACTION_TERMINAL_GRACE_SEC", "120") or "120")

    def next_seq(self) -> int:
        with self._lock:
            self._seq += 1
            return self._seq

    def on_intent(self, action_id: str, event: Dict[str, Any]) -> None:
        if not action_id:
            return
        with self._lock:
            if action_id not in self._open:
                self._open[action_id] = {
                    "opened_ms": _now_ms(),
                    "intent_event": {
                        "trade_id": event.get("trade_id"),
                        "decision_id": event.get("decision_id"),
                        "execution_id": event.get("execution_id"),
                        "symbol": event.get("symbol"),
                        "account_label": event.get("account_label"),
                        "strategy": event.get("strategy"),
                    },
                }

    def on_terminal(self, action_id: str) -> None:
        if not action_id:
            return
        with self._lock:
            self._open.pop(action_id, None)

    def sweep_overdue(self) -> List[Dict[str, Any]]:
        now = _now_ms()
        overdue: List[Dict[str, Any]] = []
        grace_ms = int(self.terminal_grace_sec * 1000)

        with self._lock:
            for aid, meta in list(self._open.items()):
                opened = int(meta.get("opened_ms") or 0)
                if opened and (now - opened) > grace_ms:
                    intent = meta.get("intent_event") if isinstance(meta.get("intent_event"), dict) else {}
                    overdue.append(
                        {
                            "event_type": ACTION_TERMINAL_MISSING,
                            "ts": now,
                            "action_id": aid,
                            "learning_valid": False,
                            "invalid_reason": ["terminal_missing"],
                            "payload": {
                                "reason": "terminal event not emitted within grace window",
                                "grace_sec": self.terminal_grace_sec,
                                "opened_ms": opened,
                                "intent_context": intent,
                            },
                        }
                    )
                    self._open.pop(aid, None)

        return overdue


_TRACKER = _ActionTracker()


def _attach_event_meta(event: Dict[str, Any]) -> None:
    if not isinstance(event, dict):
        return
    if "ts" not in event:
        event["ts"] = _now_ms()

    event.setdefault("event_id", str(uuid.uuid4()))
    event.setdefault("event_ts_ms", int(event.get("ts") or _now_ms()))
    event.setdefault("event_seq", _TRACKER.next_seq())
    event.setdefault("component", SPINE_COMPONENT)
    event.setdefault("host", HOSTNAME)
    event.setdefault("pid", PID)
    event.setdefault("thread_id", threading.get_ident())
    event.setdefault("learning_valid", True)


def _enforce_chain_integrity(event: Dict[str, Any]) -> None:
    et = _safe_str(event.get("event_type")).lower()

    def mark_invalid(reason: str) -> None:
        event["learning_valid"] = False
        rs = event.get("invalid_reason")
        if not isinstance(rs, list):
            rs = []
        rs.append(reason)
        event["invalid_reason"] = rs

    if et in _TERMINALS or et == ACTION_TERMINAL_MISSING:
        if not _safe_str(event.get("action_id")):
            mark_invalid("missing_action_id")

    if et in ("outcome_record", "outcome_enriched"):
        if not _safe_str(event.get("execution_id")):
            tags = event.get("tags")
            if not isinstance(tags, list):
                tags = []
