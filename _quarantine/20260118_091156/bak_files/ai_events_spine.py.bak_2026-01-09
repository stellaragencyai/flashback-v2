def _attach_phase6_fields_for_setup(event: Dict[str, Any]) -> None:
    try:
        if "ai_state_snapshot" not in event:
            event["ai_state_snapshot"] = _build_ai_state_snapshot(event)
        if "decision_context" not in event:
            event["decision_context"] = _build_decision_context(event)
        if "capital_intent" not in event:
            event["capital_intent"] = _build_capital_intent(event)
    except Exception as e:
        event["phase6_error"] = repr(e)

    try:
        if "treasury" not in event and _env_bool("AI_EVENTS_ATTACH_TREASURY", "false"):
            if _get_balance_snapshot is None:
                raise RuntimeError("get_balance_snapshot unavailable")
            snap = _get_balance_snapshot(  # type: ignore[misc]
                exchange=event.get("exchange", "bybit"),
                subaccount=event.get("account_label"),
                dry_run=True,
            )
            event["treasury"] = _normalize_treasury_snapshot(
                {
                    "total_equity": snap.total_equity(),
                    "balances": snap.balances,
                    "timestamp_ns": snap.timestamp_ns,
                }
            )
    except Exception as e:
        event["treasury_error"] = repr(e)


# ---------------------------------------------------------------------------
# Corruption detector (warn only)
# ---------------------------------------------------------------------------

def _warn_if_setups_jsonl_corrupted() -> None:
    try:
        if not SETUPS_PATH.exists():
            return
        if SETUPS_PATH.stat().st_size <= 0:
            return
        b = SETUPS_PATH.read_bytes()
        if b"\n" not in b:
            log.warning(
                "[ai_events] CORRUPTED_JSONL: setups.jsonl has NO real newlines. path=%s size=%s",
                str(SETUPS_PATH),
                SETUPS_PATH.stat().st_size,
            )
    except Exception:
        return


# ---------------------------------------------------------------------------
# Canonical processor (single-writer)
# ---------------------------------------------------------------------------

def _process_canonical_event(event: Dict[str, Any]) -> None:
    if not isinstance(event, dict):
        return
    if "event_type" not in event:
        return

    _attach_event_meta(event)
    _stamp_policy(event)
    _enforce_chain_integrity(event)

    etype = _safe_str(event.get("event_type")).strip().lower()
    event_seq = int(event.get("event_seq") or 0)

    sweep_every = int(os.getenv("AI_EVENTS_ACTION_SWEEP_EVERY_N", "50") or "50")
    if sweep_every > 0 and event_seq > 0 and (event_seq % sweep_every) == 0:
        for overdue_evt in _TRACKER.sweep_overdue():
            _attach_event_meta(overdue_evt)
            _stamp_policy(overdue_evt)
            _append_jsonl_strict(SPINE_EVENTS_PATH, overdue_evt)
            if ai_events_bus is not None:
                try:
                    ai_events_bus.append(overdue_evt)  # type: ignore[attr-defined]
                except Exception:
                    pass

    if etype == ACTION_INTENT:
        action_id = _safe_str(event.get("action_id"))
        if action_id:
            _TRACKER.on_intent(action_id, event)
        else:
            event["learning_valid"] = False
            event.setdefault("invalid_reason", [])
            if isinstance(event["invalid_reason"], list):
                event["invalid_reason"].append("missing_action_id_on_intent")

    if etype in _TERMINALS:
        action_id = _safe_str(event.get("action_id"))
        if action_id:
            _TRACKER.on_terminal(action_id)

    if etype == "setup_context":
        _ensure_setup_fingerprint(event)

        st = _safe_str(event.get("setup_type")).lower()
        if st == "unknown":
            log.warning(
                "spine_drop_unknown_setup trade_id=%s symbol=%s account=%s",
                event.get("trade_id"),
                event.get("symbol"),
                event.get("account_label"),
            )
            return

        _attach_phase6_fields_for_setup(event)
        _warn_if_setups_jsonl_corrupted()

        ok = _append_jsonl_strict(SETUPS_PATH, event)
        if not ok:
            event["learning_valid"] = False
            event.setdefault("invalid_reason", [])
            if isinstance(event["invalid_reason"], list):
                event["invalid_reason"].append("write_failed:setups")

        _ensure_decision_for_setup(event)

        trade_id = event.get("trade_id")
        if trade_id:
            try:
                pending = _load_pending()
                for k in _extract_setup_alias_keys(event):
                    pending[str(k)] = event
                _save_pending(pending)
            except Exception as e:
                log.warning("[ai_events] pending registry update failed trade_id=%r err=%r", trade_id, e)

    elif etype == "outcome_record":
        _ensure_outcome_fingerprints(event)
        _append_jsonl_strict(OUTCOMES_RAW_PATH, event)

        trade_id = event.get("trade_id")
        setup_evt: Optional[Dict[str, Any]] = None
        pending: Dict[str, Any] = {}

        if trade_id:
            try:
                pending = _load_pending()
                setup_evt, _matched_key = _find_pending_setup(pending, str(trade_id))
            except Exception:
                setup_evt = None

        if setup_evt:
            enriched = _merge_setup_and_outcome(setup_evt, event)
            _ensure_outcome_fingerprints(enriched)

            try:
                s_ts = int(setup_evt.get("ts") or 0)
                o_ts = int(event.get("ts") or 0)
                if s_ts and o_ts and o_ts < s_ts:
                    enriched["ordering_violation"] = True
                    enriched["learning_valid"] = False
                    enriched.setdefault("invalid_reason", [])
                    if isinstance(enriched["invalid_reason"], list):
                        enriched["invalid_reason"].append("outcome_before_setup")
            except Exception:
                pass

            _append_jsonl_strict(OUTCOMES_PATH, enriched)
            _emit_memory_from_enriched(enriched)

            try:
                _remove_pending_setup(pending, setup_evt)
                _save_pending(pending)
            except Exception as e:
                log.warning("[ai_events] pending removal failed trade_id=%r err=%r", trade_id, e)
        else:
            _append_jsonl_strict(OUTCOMES_ORPHANS_PATH, event)

    _append_jsonl_strict(SPINE_EVENTS_PATH, event)

    if ai_events_bus is not None:
        try:
            ai_events_bus.append(event)  # type: ignore[attr-defined]
        except Exception:
            pass


# ---------------------------------------------------------------------------
# Producer API (enqueue only)
# ---------------------------------------------------------------------------

def publish_ai_event(event: Dict[str, Any]) -> None:
    """
    Producer-safe entrypoint.
    Enqueues into the account-scoped inbox.
    """
    if not isinstance(event, dict):
        return
    if "event_type" not in event:
        return
    if "ts" not in event:
        event["ts"] = _now_ms()

    # IMPORTANT:
    # If spine_api.emit_ai_event exists, it may route to a GLOBAL inbox.
    # Only use it when explicitly allowed AND we're main (compat).
    allow_spine_api_emit = _env_bool("ALLOW_SPINE_API_EMIT", "false")
    if allow_spine_api_emit and IS_MAIN and _emit_ai_event is not None:
        try:
            _emit_ai_event(event)  # type: ignore[misc]
            return
        except Exception:
            pass

    try:
        _append_jsonl_strict(AI_EVENTS_INBOX_PATH, event)
    except Exception:
        return


# ---------------------------------------------------------------------------
# Builders (unchanged)
# ---------------------------------------------------------------------------

def _coerce_setup_type(st: Any) -> str:
    s = _safe_str(st)
    return s if s else "unknown"


def build_setup_context(
    *,
    trade_id: str,
    symbol: str,
    account_label: str,
    strategy: str,
    features: Dict[str, Any],
    setup_type: Optional[str] = None,
    timeframe: Optional[str] = None,
    ai_profile: Optional[str] = None,
    extra: Optional[Dict[str, Any]] = None,
) -> SetupRecord:
    st = _coerce_setup_type(setup_type)
    tf = _normalize_timeframe(timeframe)
    if tf is None and isinstance(extra, dict):
        tf = _normalize_timeframe(extra.get("timeframe"))
    if tf is None:
        tf = "unknown"

    feats = features if isinstance(features, dict) else {}
    payload: SetupRecord = {
        "event_type": "setup_context",
        "ts": _now_ms(),
        "trade_id": trade_id,
        "symbol": symbol,
        "account_label": account_label,
        "strategy": strategy,
        "setup_type": st,
        "timeframe": tf,
        "payload": {"features": feats or {}},
    }

    if ai_profile is not None:
        payload["ai_profile"] = ai_profile

    if extra or tf is not None:
        payload_extra = dict(extra or {})
        payload_extra["timeframe"] = tf
        payload["payload"]["extra"] = payload_extra

    _stamp_policy(payload)  # type: ignore[arg-type]
    _ensure_setup_fingerprint(payload)  # type: ignore[arg-type]
    return payload


def build_outcome_record(
    *,
    trade_id: str,
    symbol: str,
    account_label: str,
    strategy: str,
    pnl_usd: float,
    r_multiple: Optional[float] = None,
    win: Optional[bool] = None,
    exit_reason: Optional[str] = None,
    extra: Optional[Dict[str, Any]] = None,
) -> OutcomeRecord:
    payload: OutcomeRecord = {
        "event_type": "outcome_record",
        "ts": _now_ms(),
        "trade_id": trade_id,
        "symbol": symbol,
        "account_label": account_label,
        "strategy": strategy,
        "payload": {
            "pnl_usd": float(pnl_usd),
            "r_multiple": float(r_multiple) if r_multiple is not None else None,
            "win": bool(win) if win is not None else None,
            "exit_reason": exit_reason,
        },
    }
    if extra:
        payload["payload"]["extra"] = extra
    _stamp_policy(payload)  # type: ignore[arg-type]
    return payload


# ---------------------------------------------------------------------------
# Inbox draining (spine core)
# ---------------------------------------------------------------------------

def _fallback_read_cursor(path: Path) -> int:
    try:
        if not path.exists():
            return 0
        s = path.read_text(encoding="utf-8").strip()
        return int(s or "0")
    except Exception:
        return 0


def _fallback_write_cursor(path: Path, offset: int) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(str(int(offset)), encoding="utf-8")
    except Exception:
        return


def _fallback_read_jsonl_from_offset(path: Path, offset: int, max_bytes: int, max_lines: int) -> Tuple[List[Dict[str, Any]], int, int, int]:
    rows: List[Dict[str, Any]] = []
    bad = 0
    bytes_read = 0
    try:
        if not path.exists():
            return rows, offset, bad, bytes_read
        size = path.stat().st_size
        if offset > size:
            offset = 0

        with path.open("rb") as f:
            f.seek(offset)
            start = f.tell()
            while True:
                if len(rows) >= max_lines:
                    break
                if (f.tell() - start) >= max_bytes:
                    break
                line = f.readline()
                if not line:
                    break
                bytes_read += len(line)
                raw = line.strip()
                if not raw:
                    continue
                try:
                    if orjson is not None:
                        d = orjson.loads(raw)
                    else:
                        d = json.loads(raw.decode("utf-8", errors="ignore"))
                    if isinstance(d, dict):
                        rows.append(d)
                    else:
                        bad += 1
                except Exception:
                    bad += 1
            next_off = f.tell()
        return rows, next_off, bad, bytes_read
    except Exception:
        return rows, offset, bad, bytes_read


def drain_inbox_once(*, max_bytes: int = 8_388_608, max_lines: int = 10_000) -> int:
    try:
        inbox = AI_EVENTS_INBOX_PATH
        cursor_path = AI_EVENTS_INBOX_CURSOR_PATH

        if not inbox.exists() or inbox.stat().st_size <= 0:
            return 0

        if _read_cursor is not None and _write_cursor is not None and _read_jsonl_from_offset is not None:
            size = inbox.stat().st_size
            offset = int(_read_cursor(cursor_path))  # type: ignore[misc]
            if offset > size:
                offset = 0
            rows, next_offset, bad, _bytes_read = _read_jsonl_from_offset(  # type: ignore[misc]
                inbox, offset=offset, max_bytes=max_bytes, max_lines=max_lines
            )
            if bad:
                log.warning("[ai_events_spine] inbox bad_lines=%s (skipped)", bad)
            if not rows:
                _write_cursor(cursor_path, int(next_offset))  # type: ignore[misc]
                return 0
            processed = 0
            for evt in rows:
                if isinstance(evt, dict):
                    _process_canonical_event(evt)
                    processed += 1
            _write_cursor(cursor_path, int(next_offset))  # type: ignore[misc]
            return processed

        # fallback mode (still functional)
        size = inbox.stat().st_size
        offset = _fallback_read_cursor(cursor_path)
        if offset > size:
            offset = 0
        rows, next_offset, bad, _bytes_read = _fallback_read_jsonl_from_offset(inbox, offset, max_bytes, max_lines)
        if bad:
            log.warning("[ai_events_spine] inbox bad_lines=%s (skipped)", bad)
        processed = 0
        for evt in rows:
            if isinstance(evt, dict):
                _process_canonical_event(evt)
                processed += 1
        _fallback_write_cursor(cursor_path, int(next_offset))
        return processed

    except Exception as e:
        log.warning("[ai_events_spine] drain_inbox_once failed: %r", e)
        return 0


# ---------------------------------------------------------------------------
# Ops tick
# ---------------------------------------------------------------------------

def run_once_tick() -> None:
    try:
        record_heartbeat("ai_events_spine")
    except Exception:
        pass

    try:
        max_bytes = int(os.getenv("AI_EVENTS_INBOX_DRAIN_MAX_BYTES", "8388608") or "8388608")
        max_lines = int(os.getenv("AI_EVENTS_INBOX_DRAIN_MAX_LINES", "10000") or "10000")
        n = drain_inbox_once(max_bytes=max_bytes, max_lines=max_lines)
        if n:
            log.info("[ai_events_spine] drained inbox events=%s (account=%s dir=%s)", n, ACCOUNT_LABEL, str(AI_EVENTS_DIR))
    except Exception:
        pass

    try:
        if _env_bool("AI_EVENTS_SPINE_TICK_MEMORY_SNAPSHOT", "true"):
            snap = _load_memory_snapshot()
            _save_memory_snapshot(snap)
    except Exception as e:
        log.warning("[ai_events_spine] tick memory_snapshot failed: %r", e)

    try:
        if _env_bool("AI_EVENTS_SPINE_TICK_PENDING", "true"):
            reg = _load_pending()
            _save_pending(reg)
    except Exception as e:
        log.warning("[ai_events_spine] tick pending failed: %r", e)

    try:
        overdue = _TRACKER.sweep_overdue()
        for evt in overdue:
            _attach_event_meta(evt)
            _stamp_policy(evt)
            _append_jsonl_strict(SPINE_EVENTS_PATH, evt)
            if ai_events_bus is not None:
                try:
                    ai_events_bus.append(evt)  # type: ignore[attr-defined]
                except Exception:
                    pass
    except Exception:
        pass


def loop(interval_sec: float = 2.0) -> None:
    log.info(
        "AI Events Spine loop started (single-writer). account=%s dir=%s interval_sec=%s fsync=%s inbox=%s cursor=%s",
        ACCOUNT_LABEL,
        str(AI_EVENTS_DIR),
        interval_sec,
        AI_EVENTS_FSYNC,
        str(AI_EVENTS_INBOX_PATH),
        str(AI_EVENTS_INBOX_CURSOR_PATH),
    )
    while True:
        run_once_tick()
        time.sleep(max(0.25, float(interval_sec)))


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--once", action="store_true", help="Run one ops tick (includes inbox drain) and exit")
    ap.add_argument("--drain-once", action="store_true", help="Drain inbox once and exit")
    ap.add_argument(
        "--interval",
        type=float,
        default=float(os.getenv("AI_EVENTS_SPINE_INTERVAL", "2") or "2"),
        help="Loop interval seconds",
    )
    args = ap.parse_args()

    if args.drain_once:
        n = drain_inbox_once()
        log.info("[ai_events_spine] drain-once processed=%s (account=%s dir=%s)", n, ACCOUNT_LABEL, str(AI_EVENTS_DIR))
        return

    if args.once:
        run_once_tick()
        return

    loop(interval_sec=float(args.interval))


if __name__ == "__main__":
    main()
