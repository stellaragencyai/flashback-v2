ACTION_INTENT = "action_intent"
ACTION_EXECUTED = "action_executed"
ACTION_BLOCKED = "action_blocked"
ACTION_REJECTED = "action_rejected"
ACTION_FAILED = "action_failed"
ACTION_TERMINAL_MISSING = "action_terminal_missing"

_TERMINALS: Set[str] = {ACTION_EXECUTED, ACTION_BLOCKED, ACTION_REJECTED, ACTION_FAILED}

SPINE_COMPONENT = str(os.getenv("AI_EVENTS_COMPONENT", "ai_events_spine")).strip() or "ai_events_spine"
