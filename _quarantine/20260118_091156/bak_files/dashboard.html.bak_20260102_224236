<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Flashback Trading Cockpit</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root{
      --bg: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --card: #ffffff;
      --surface: #ffffff;
      --border: #e2e8f0;
      --shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 10px 30px rgba(15, 23, 42, 0.06);

      --green: #16a34a;
      --red: #dc2626;
      --yellow: #f59e0b;
      --gray: #64748b;

      --chip: #f1f5f9;
      --chipText: #334155;

      --blue: #2563eb;
      --blueSoft: rgba(37,99,235,.12);
      --greenSoft: rgba(22,163,74,.12);
      --redSoft: rgba(220,38,38,.12);
      --yellowSoft: rgba(245,158,11,.14);
      --graySoft: rgba(100,116,139,.12);

      --staleBg: rgba(15, 23, 42, 0.02);
      --deadBg: rgba(15, 23, 42, 0.02);
    }

    

    html[data-theme="dark"]{
      --bg: #0b0f19;
      --text: #f8fafc;
      --muted: #94a3b8;
      --card: #0f172a;
      --surface: #0b1220;
      --border: rgba(148,163,184,.22);
      --shadow: 0 1px 2px rgba(0,0,0,.40), 0 10px 30px rgba(0,0,0,.35);

      --chip: rgba(148,163,184,.14);
      --chipText: #e2e8f0;

      /* keep --green --red --yellow --blue as-is (accents stay same) */
      --staleBg: rgba(245, 158, 11, 0.10);
      --deadBg: rgba(220, 38, 38, 0.10);
    }

*{box-sizing:border-box}
    body{
      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 22px;
    }

    .topbar{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap: 16px;
      margin-bottom: 14px;
    }

    h1{
      margin: 0;
      font-size: 18px;
      font-weight: 750;
      letter-spacing: .2px;
    }

    .subhead{
      margin: 6px 0 0 0;
      color: var(--muted);
      font-size: 13px;
      display:flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items:center;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 10px;
      font-size: 12px;
      color: var(--chipText);
      font-weight: 650;
      cursor: pointer;
      box-shadow: 0 1px 0 rgba(15, 23, 42, 0.04);
      white-space: nowrap;
      text-decoration: none;
      user-select: none;
    }
    .btn:hover{ border-color: rgba(37,99,235,.35); }
    .btn.active{
      border-color: var(--blue);
      background: var(--blueSoft);
      color: var(--blue);
    }

    .btns{
      display:flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items:center;
      justify-content:flex-end;
    }

    .controls{
      display:flex;
      gap: 10px;
      align-items:center;
      justify-content:flex-end;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .input{
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 12px;
      min-width: 220px;
      outline: none;
    }
    .select{
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 12px;
      outline: none;
      background: var(--surface);
    }

    /* --- GLOBAL TRUTH BANNER --- */
    .metaBanner{
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 14px;
      padding: 12px 14px;
      box-shadow: var(--shadow);
      margin: 0 0 16px 0;
    }
    .metaTitle{
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .35px;
      color: var(--muted);
      text-transform: uppercase;
      display:flex;
      justify-content:space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
    .metaRow{
      margin-top: 10px;
      display:flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items:center;
    }
    .pill{
      display:inline-flex;
      align-items:center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--chip);
      color: var(--chipText);
      font-size: 12px;
      font-weight: 850;
      white-space: nowrap;
      max-width: 100%;
    }
    .pill.blue{ background: var(--blueSoft); border-color: rgba(37,99,235,.25); color: var(--blue); }
    .pill.green{ background: var(--greenSoft); border-color: rgba(22,163,74,.25); color: var(--green); }
    .pill.yellow{ background: var(--yellowSoft); border-color: rgba(245,158,11,.35); color: #92400e; }
    .pill.red{ background: var(--redSoft); border-color: rgba(220,38,38,.25); color: var(--red); }
    .pill.gray{ background: var(--graySoft); border-color: rgba(100,116,139,.25); color: var(--gray); }
    .mono{ font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; }
    .dim{ color: var(--muted); font-weight: 700; }

    .summary{
      display:grid;
      grid-template-columns: repeat(5, minmax(210px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .sCard{
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      box-shadow: var(--shadow);
      min-height: 72px;
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap: 10px;
    }

    .sK{ color: var(--muted); font-size: 12px; font-weight: 650; }
    .sV{ margin-top: 6px; font-size: 20px; font-weight: 800; letter-spacing:.2px; }

    .grid{
      display:grid;
      grid-template-columns:repeat(3, minmax(360px, 1fr));
      gap: 14px;
    }

    @media (max-width: 1180px){
      .summary{ grid-template-columns: repeat(2, minmax(220px, 1fr)); }
      .grid{ grid-template-columns:repeat(2, minmax(340px, 1fr)); }
    }
    @media (max-width: 820px){
      .summary{ grid-template-columns: 1fr; }
      .grid{ grid-template-columns: 1fr; }
    }

    .card{
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 14px;
      box-shadow: var(--shadow);
      position: relative;
      overflow:hidden;
    }

    /* left accent strip driven by state_color */
    .card::before{
      content:"";
      position:absolute;
      left:0; top:0; bottom:0;
      width: 6px;
      background: var(--graySoft);
    }
    .card.green::before{ background: rgba(22,163,74,.85); }
    .card.yellow::before{ background: rgba(245,158,11,.90); }
    .card.red::before{ background: rgba(220,38,38,.85); }
    .card.gray::before{ background: rgba(100,116,139,.55); }

    /* SIM watermark */
    .watermark{
      position:absolute;
      inset: 0;
      display:none;
      align-items:center;
      justify-content:center;
      pointer-events:none;
      transform: rotate(-18deg);
      font-weight: 950;
      letter-spacing: 2px;
      font-size: 54px;
      color: rgba(15,23,42,.03);
      text-transform: uppercase;
      z-index: 1;
      user-select:none;
    }
    .card.sim .watermark{ display:flex; }

    /* stale overlay tint */
    .card.stale{ background: var(--card); }
    .card.dead{ background: var(--card); }

    .header{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap: 10px;
      margin-bottom: 10px;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }

    .acctWrap{ display:flex; gap: 10px; align-items:center; }

    .avatar{
      width: 34px; height: 34px;
      border-radius: 10px;
      background: #0f172a;
      color: #fff;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight: 900;
      font-size: 12px;
      letter-spacing:.4px;
      flex: 0 0 auto;
    }

    .acctName{
      font-size: 14px;
      font-weight: 900;
      line-height: 1.15;
    }

    .acctMeta{
      margin-top: 3px;
      font-size: 12px;
      color: var(--muted);
      display:flex;
      gap: 8px;
      align-items:center;
      flex-wrap: wrap;
    }

    .badge{
      font-size: 11px;
      font-weight: 900;
      border-radius: 999px;
      padding: 3px 10px;
      border: 1px solid var(--border);
      background: var(--chip);
      color: var(--chipText);
      text-transform: uppercase;
      letter-spacing: .35px;
      white-space: nowrap;
    }

    .badge.green{ background: var(--chip); border-color: var(--border); color: var(--chipText); }
    .badge.red{ background: var(--chip); border-color: var(--border); color: var(--chipText); }
    .badge.yellow{ background: var(--chip); border-color: var(--border); color: var(--chipText); }
    .badge.gray{ background: var(--chip); border-color: var(--border); color: var(--chipText); }

    .rightPills{
      display:flex;
      gap: 8px;
      align-items:center;
      flex-wrap: wrap;
      justify-content:flex-end;
    }

    .twoCols{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 10px 0 10px 0;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }

    .mini{
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 12px;
      background: var(--surface);
    }

    .miniK{ font-size: 12px; color: var(--muted); font-weight: 650; }
    .miniV{ margin-top: 6px; font-size: 18px; font-weight: 900; }

    .triple{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 10px 0;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }
    .stat{
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 12px;
      background: var(--surface);
    }
    .statK{ font-size: 12px; color: var(--muted); font-weight: 650; }
    .statV{ margin-top: 6px; font-size: 14px; font-weight: 900; }
    .pos{ color: var(--green); }
    .neg{ color: var(--text); }

    .bar{
      height: 8px;
      border-radius: 999px;
      background: #eef2f7;
      overflow:hidden;
      margin-top: 8px;
      border: 1px solid var(--border);
    }
    .fill{
      height: 100%;
      width: 0%;
      background: var(--blue);
    }
    .barLabel{
      display:flex;
      justify-content:space-between;
      margin-top: 8px;
      font-size: 12px;
      color: var(--muted);
      font-weight: 650;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }

    .chips{
      display:flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--chip);
      font-size: 12px;
      color: var(--chipText);
      font-weight: 800;
      white-space: nowrap;
      max-width: 100%;
    }
    
    .truncate{
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-block;
      vertical-align: bottom;
    }
.chip.warn{
      background: var(--yellowSoft);
      border-color: rgba(245,158,11,.35);
      color: #92400e;
    }
    .chip.danger{ background: var(--graySoft); border-color: rgba(100,116,139,.25); color: var(--chipText); }

    
    .alertSpacer{
      margin-top: 10px;
      padding-left: 6px;
      position: relative;
      z-index: 2;
      /* Match the typical alert row height so cards line up */
      min-height: 44px;
    }

    /* Make inner grids align better across cards */
    .twoCols .mini{ min-height: 96px; }
    .triple .stat{ min-height: 74px; }

    /* Keep details from collapsing layout when content varies */
    details{ margin-top: 10px; }

    .alertBox{
      margin-top: 10px;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }
    .alert{ border: 1px solid rgba(100,116,139,.25); background: rgba(100,116,139,.10); color: var(--chipText); border-radius: 12px; padding: 10px 12px; display:flex; justify-content:space-between; align-items:center; gap: 10px; flex-wrap: wrap; font-size: 12px; font-weight: 800; }
    .alert .actions{
      display:flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .smallBtn{
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 10px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 850;
      cursor: pointer;
      user-select:none;
    }
    .smallBtn:hover{ border-color: rgba(37,99,235,.35); }

    details{
      margin-top: 10px;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }
    summary{
      cursor:pointer;
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      user-select:none;
    }

    .footer{
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      display:flex;
      justify-content:space-between;
      gap: 10px;
      flex-wrap: wrap;
      padding-left: 6px;
      position: relative;
      z-index: 2;
    }
  
    /* --- Step 16: Symmetry alignment --- */
    .twoCols{ align-items: stretch; }
    .mini, .stat{
      display:flex;
      flex-direction:column;
      justify-content:flex-start;
      min-height: 86px;
    }
    .miniV{ line-height: 1.15; }
    .statV{ line-height: 1.15; }
    .triple{ align-items: stretch; }
    .miniK, .statK{ white-space: nowrap; overflow:hidden; text-overflow: ellipsis; }

  
    /* --- Dark mode polish: ensure inputs/selects readable --- */
    html[data-theme="dark"] .input,
    html[data-theme="dark"] .select{
      color: var(--text);
    }
    html[data-theme="dark"] ::placeholder{
      color: rgba(148,163,184,.85);
    }

  
    /* --- Step 18: unify inner surfaces (reduce box-within-box look) --- */
    .mini, .stat{
      border-color: rgba(148,163,184,.18);
      box-shadow: none;
    }
    .chip{
      border-color: rgba(148,163,184,.18);
    }
    .badge{
      border-color: rgba(148,163,184,.22);
    }
    details{
      margin-top: 8px;
    }
    summary{
      opacity: .9;
    }

    /* In dark mode, soften borders further */
    html[data-theme="dark"] .mini,
    html[data-theme="dark"] .stat,
    html[data-theme="dark"] .chip,
    html[data-theme="dark"] .badge{
      border-color: rgba(148,163,184,.14);
    }

  
    /* --- Step 19: calm GLOBAL TRUTH banner --- */
    .globalTruthWrap{
      margin: 10px 0 14px 0;
      border-radius: 14px;
      border: 1px solid rgba(148,163,184,.18);
      background: rgba(148,163,184,.06);
      padding: 10px 12px;
    }
    html[data-theme="dark"] .globalTruthWrap{
      background: rgba(148,163,184,.06);
      border-color: rgba(148,163,184,.14);
    }

    .globalTruthTitle{
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .35px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .globalTruthPills{
      display:flex;
      flex-wrap:wrap;
      gap: 8px;
      align-items:center;
    }

    .truthPill{
      display:inline-flex;
      align-items:center;
      gap: 8px;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,.18);
      background: rgba(148,163,184,.08);
      font-size: 11px;
      font-weight: 850;
      color: var(--text);
      white-space: nowrap;
    }

    .truthPill.red{
      border-color: rgba(220,38,38,.28);
      background: rgba(220,38,38,.10);
      color: var(--text);
    }
    .truthPill.orange{
      border-color: rgba(245,158,11,.28);
      background: rgba(245,158,11,.12);
      color: var(--text);
    }
    .truthPill.green{
      border-color: rgba(22,163,74,.25);
      background: rgba(22,163,74,.10);
      color: var(--text);
    }
    .truthPill.blue{
      border-color: rgba(37,99,235,.22);
      background: rgba(37,99,235,.10);
      color: var(--text);
    }

  
    /* ALIGNMENT LOCKS (Step 20) */
    .header{ min-height: 64px; }
    .twoCols{ min-height: 132px; }
    .triple{ min-height: 84px; }
    details{ min-height: 28px; }

    /* Keep header chips from wrapping into chaos */
    .acctMeta{ min-height: 26px; }

    /* Ensure mini/stat cards never collapse */
    .mini{ min-height: 112px; }
    .stat{ min-height: 64px; }


    /* ----------------------------
       Step 25: Fleet Mode Banner
       ---------------------------- */
    .fleetBanner{
      margin: 10px 0 16px 0;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card);
      box-shadow: var(--shadow);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .fleetLeft, .fleetRight{ display:flex; gap: 8px; flex-wrap: wrap; align-items:center; }
    .fleetChip{
      display:inline-flex;
      gap: 6px;
      align-items:baseline;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--chip);
      color: var(--chipText);
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    /* ----------------------------
       Step 26: Alignment Lock
       ---------------------------- */
    .header{ min-height: 64px; align-items:flex-start; }
    .twoCols{ min-height: 124px; }
    .triple{ min-height: 86px; align-items:stretch; }
    .mini, .stat{ height: 100%; display:flex; flex-direction:column; justify-content:space-between; }
    .acctMeta{ min-height: 22px; }
    .rightPills{ min-height: 26px; align-content:flex-start; }

    /* Tighten spacing just a bit */
    .card{ padding: 14px; }
    .chips{ margin-top: 8px; }

  
    .statusReason{
      font-size: 11px;
      color: var(--muted);
      font-weight: 800;
      text-align: right;
      max-width: 260px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: .9;
    }

</style>
</head>

<body>
  <div class="topbar">
    <div>
      <h1>Flashback Trading Cockpit</h1>
      <div class="subhead">
        <span>Auto-refresh every 4s.</span>
        <span class="truthPill">Cards: {{ rows|length }}</span>
<span class="truthPill">Orchestrator: {{ meta.orch_mode if meta else "?" }}</span>
        <span class="truthPill">Subset: {{ (meta.orch_only_labels|join(",")) if (meta and meta.orch_only_labels) else "ALL" }}</span>
<span class="truthPill">Last refresh: <span id="lastRefresh">—</span>
        {% set of = (meta.outcomes_freshness_sec if (meta and meta.outcomes_freshness_sec is not none) else none) %}
        {% set ostate = "?" %}
        {% if of is not none %}
          {% if of|float <= 3600 %}{% set ostate = "OK" %}
          {% elif of|float <= 86400 %}{% set ostate = "STALE" %}
          {% else %}{% set ostate = "DEAD" %}
          {% endif %}
        {% endif %}
        <span class="chip">Outcomes: {{ ostate }}{% if meta and meta.outcomes_last_ts_iso %} ({{ meta.outcomes_last_ts_iso }}){% endif %}</span>
</span>
      </div>

      <div class="controls">
        <input id="searchBox" class="input" placeholder="Search account / strategy / role…" />
        <select id="sortBy" class="select">
          <option value="acct">Sort: Account</option>
          <option value="status">Sort: Status</option>
          <option value="freshness">Sort: Freshness (worst first)</option>
          <option value="pnl">Sort: PnL (best first)</option>
          <option value="trades">Sort: Trades (most first)</option>
        </select>
      </div>
    </div>

    <div class="btns">
      <button class="btn" id="themeToggle" type="button">Dark</button>
      <a class="btn {% if window=='7d' %}active{% endif %}" href="/?window=7d">7D</a>
      <a class="btn {% if window=='30d' %}active{% endif %}" href="/?window=30d">30D</a>
      <a class="btn {% if window=='1y' %}active{% endif %}" href="/?window=1y">1Y</a>
      <a class="btn {% if window=='all' %}active{% endif %}" href="/?window=all">ALL</a>
    </div>
  </div>

  {# ------------------------------------------------------------ #}
  {# GLOBAL TRUTH banner (orchestrator + rowset integrity)          #}
  {# ------------------------------------------------------------ #}
  {% set m = (meta if meta is defined and meta is not none else {}) %}
  {% set orch_mode = (m.get('orch_mode') if m else None) %}
  {% set orch_only = (m.get('orch_only_labels') if m else None) %}
  {% set expected = (m.get('expected_accounts') if m else None) %}
  {% set missing = (m.get('missing_accounts') if m else None) %}
  {% set present = (m.get('present_accounts') if m else None) %}

  {% set expected_n = (expected|length if expected is iterable else 0) %}
  {% set present_n = (present|length if present is iterable else 0) %}
  {% set missing_n = (missing|length if missing is iterable else 0) %}

  {% set only_n = (orch_only|length if orch_only is iterable else 0) %}
  {% set running_subset = (true if only_n > 0 and only_n < expected_n else false) %}

  <div class="metaBanner">
    <div class="metaTitle">
      <span>GLOBAL TRUTH (Orchestrator + Fleet)</span>
      <span class="dim">This banner exists so you stop “thinking” you’re running things you’re not.</span>
    </div>

    <div class="metaRow">
      <span class="pill blue">Window: <span class="mono">{{ window|default("all") }}</span></span>

      {% if orch_mode %}
        {% set om = (orch_mode|string)|upper %}
        <span class="pill {% if 'LIVE' in om %}green{% elif 'PAPER' in om or 'DRY' in om %}yellow{% else %}gray{% endif %}">
          Orchestrator Mode: <span class="mono">{{ om }}</span>
        </span>
      {% else %}
        <span class="pill gray">Orchestrator Mode: <span class="mono">UNKNOWN</span></span>
      {% endif %}

      <span class="pill {% if missing_n > 0 %}yellow{% else %}green{% endif %}">
        Fleet: expected <span class="mono">{{ expected_n }}</span>, present <span class="mono">{{ present_n }}</span>, missing <span class="mono">{{ missing_n }}</span>
      </span>

      {% if orch_only is iterable and only_n > 0 %}
        <span class="pill {% if running_subset %}red{% else %}blue{% endif %}">
          only_labels: <span class="mono">{{ orch_only|join(", ") }}</span>
        </span>
      {% else %}
        <span class="pill gray">only_labels: <span class="mono">ALL (or not provided)</span></span>
      {% endif %}

      {% if running_subset %}
        <span class="pill red">⚠ RUNNING SUBSET: dashboard rows exist for all accounts, but orchestrator is only running some.</span>
      {% endif %}
    </div>
  </div>

  {# ------------------------------------------------------------ #}
  {# Summary tiles computed from rows (truth-first, fail-soft).     #}
  {# ------------------------------------------------------------ #}
  {% set ns = namespace(acct_count=0, online_count=0, total_trades=0, pnl_sum=0.0, stale_count=0, dead_count=0, sim_count=0) %}
  {% for r in rows %}
    {% if r.account_label %}
      {% set ns.acct_count = ns.acct_count + 1 %}
      {% if r.is_online %}{% set ns.online_count = ns.online_count + 1 %}{% endif %}
      {% set ns.total_trades = ns.total_trades + (r.total_trades or 0) %}
      {% set ns.pnl_sum = ns.pnl_sum + (r.pnl_usd_total or 0.0) %}
      {% set f = (r.outcomes_freshness_sec if r.outcomes_freshness_sec is not none else none) %}
      {% if f is not none and f|float > 3600 %}{% set ns.stale_count = ns.stale_count + 1 %}{% endif %}
      {% if f is not none and f|float > 86400 %}{% set ns.dead_count = ns.dead_count + 1 %}{% endif %}
      {% set m2 = (r.automation_mode or "")|upper %}
      {% if "LIVE" not in m2 %}{% set ns.sim_count = ns.sim_count + 1 %}{% endif %}
    {% endif %}
  {% endfor %}

  <div class="summary">
    <div class="sCard">
      <div>
        <div class="sK">Total Trades ({{ window|default("all") }})</div>
        <div class="sV" id="sumTotalTrades">{{ ns.total_trades }}</div>
      </div>
    </div>

    <div class="sCard">
      <div>
        <div class="sK">PnL Total USD ({{ window|default("all") }})</div>
        <div class="sV {% if ns.pnl_sum >= 0 %}pos{% else %}neg{% endif %}" id="sumPnlTotal">
          ${{ "%.2f"|format(ns.pnl_sum) }}
        </div>
      </div>
    </div>

    <div class="sCard">
      <div>
        <div class="sK">Online / Total</div>
        <div class="sV" id="sumOnlineTotal">{{ ns.online_count }} / {{ ns.acct_count }}</div>
      </div>
    </div>

    <div class="sCard">
      <div>
        <div class="sK">Stale / Dead Outcomes</div>
        <div class="sV" id="sumStaleDead">{{ ns.stale_count }} / {{ ns.dead_count }}</div>
      </div>
    </div>

    <div class="sCard">
      <div>
        <div class="sK">SIMULATED Cards</div>
        <div class="sV" id="sumSimCards">{{ ns.sim_count }}</div>
      </div>
    </div>
  </div>

  {# ------------------------------------------------------------ #}
  {# Order cards: flashbackXX first, main last (no backend changes). #}
  {# ------------------------------------------------------------ #}
  {% set fb_rows = rows|rejectattr('account_label','equalto','main')|list %}
  {% set main_rows = rows|selectattr('account_label','equalto','main')|list %}
  {% set ordered = fb_rows + main_rows %}

  <div class="grid" id="cardsGrid">
    {% for r in ordered %}
      {% set acct = (r.account_label or "unknown") %}
      {% set strat = (r.strategy or "unknown") %}
      {% set mode = (r.automation_mode or "unknown") %}
      {% set role = (r.role or "") %}
      {% set enabled = (true if (r.enabled is not none and r.enabled) else false) %}
      {% set is_online = (true if r.is_online else false) %}
      {% set sup_ok = (true if (r.get('supervisor_ok')) else false) %}
      {% set sup_age = (r.get('supervisor_age_sec')) %}
      {% set dead = (r.workers_dead if r.workers_dead is not none else []) %}
      {% set dead_count = (dead|length if dead is not none else 0) %}

      {% set fresh = (r.outcomes_freshness_sec if r.outcomes_freshness_sec is not none else none) %}
            {% set trades = (r.total_trades if r.total_trades is not none else 0) %}

{% set stale = (true if (trades|int > 0 and fresh is not none and fresh|float > 3600) else false) %}
      {% set dead_outcomes = (true if (trades|int > 0 and fresh is not none and fresh|float > 86400) else false) %}

      {% set status_norm = "UNKNOWN" %}
      {% if not enabled %}
        {% set status_norm = "STOPPED" %}
      {% elif is_online and sup_ok and dead_count == 0 %}
        {% set status_norm = "ONLINE" %}
      {% elif is_online and (not sup_ok or dead_count > 0) %}
        {% set status_norm = "DEGRADED" %}
      {% elif enabled and not is_online %}
        {% set status_norm = "OFFLINE" %}
      {% endif %}

      {% set color = "gray" %}
      {% if status_norm == "ONLINE" %}{% set color = "green" %}
      {% elif status_norm == "DEGRADED" %}{% set color = "yellow" %}
      {% elif status_norm == "OFFLINE" %}{% set color = "gray" %}
      {% elif status_norm == "STOPPED" %}{% set color = "gray" %}
      {% endif %}
{% if acct == "main" %}
        {% set avatar = "MA" %}
        {% set acct_name = "Main Trading Account" %}
      {% else %}
        {% set digits = acct|replace("flashback","") %}
        {% set digits = digits|replace("_","") %}
        {% if digits|length == 1 %}{% set digits = "0" ~ digits %}{% endif %}
        {% set avatar = "FB" ~ digits %}
        {% set acct_name = acct %}
      {% endif %}

      {% if r.win_rate_pct is not none %}
        {% set win_pct = r.win_rate_pct|float %}
      {% else %}
        {% set wr = (r.win_rate if r.win_rate is not none else 0.0) %}
        {% set win_pct = (wr|float * 100.0) %}
      {% endif %}

      {% set pnl = (r.pnl_usd_total if r.pnl_usd_total is not none else 0.0) %}
      {% set pnl_avg = (r.pnl_usd_avg if r.pnl_usd_avg is not none else 0.0) %}
      {% set trades = (r.total_trades if r.total_trades is not none else 0) %}
      {% set last_iso = (r.outcomes_last_ts_iso if r.outcomes_last_ts_iso else "—") %}

      {% set mU = (mode|upper) %}
      {% set is_live = (true if "LIVE" in mU else false) %}
      {% set funds_source = ("REAL" if is_live else "SIM") %}
      {% set is_sim = (not is_live) %}

      {% set age = (sup_age if sup_age is not none else 999999) %}
      {% set risk_pct = ((age|float / 60.0) * 25.0) %}
      {% if risk_pct < 0 %}{% set risk_pct = 0 %}{% endif %}
      {% if risk_pct > 100 %}{% set risk_pct = 100 %}{% endif %}
      {% set w = risk_pct %}

      {% set cardFlags = "" %}
      {% if is_sim %}{% set cardFlags = cardFlags ~ " sim" %}{% endif %}
      <div class="card {{ color }}{{ cardFlags }}"
           data-acct="{{ acct|e }}"
           data-strat="{{ strat|e }}"
           data-role="{{ role|e }}"
           data-status="{{ status_norm|e }}"
           data-fresh="{{ fresh if fresh is not none else 0 }}"
           data-pnl="{{ pnl }}"
           data-trades="{{ trades }}">
        <div class="watermark">SIMULATED</div>

        <div class="header">
          <div class="acctWrap">
            <div class="avatar">{{ avatar|upper }}</div>
            <div>
              <div class="acctName">{{ acct_name }}</div>
              <div class="acctMeta">
                <span class="badge {% if is_live %}green{% else %}gray{% endif %} js-mode">{{ mU }}</span>
                <span class="badge {% if r.funds_source == \"REAL\" %}green{% else %}gray{% endif %}">FUNDS: {{ r.funds_source if r.funds_source else funds_source }}</span>
                <span class="chip truncate" title="Strategy: {{ strat }}">Strategy: {{ strat }}</span>
                {% if role %}<span class="chip truncate" title="Role: {{ role }}">Role: {{ role }}</span>{% endif %}
                {% if meta and meta.orch_only_labels and (acct not in meta.orch_only_labels) %}
                  <span class="chip" style="opacity:.75;">Not scheduled (subset)</span>
                {% endif %}

              </div>
            </div>
          </div>

          <div class="rightPills">
            <div class="badge {{ color }} js-status">{{ status_norm }}</div>
            {% if status_norm != "ONLINE" %}
              {% set why = "" %}
              {% if r.status_reason %}{% set why = r.status_reason %}
              {% elif r.orch_reason %}{% set why = r.orch_reason %}
              {% elif r.orch_status and (r.orch_status|string|upper) == "SKIPPED" %}{% set why = "SKIPPED: " ~ (r.orch_reason or "not scheduled") %}
              {% elif status_norm == "STOPPED" %}{% set why = "Disabled" %}
              {% elif status_norm == "OFFLINE" %}{% set why = "Supervisor not running" %}
              {% elif status_norm == "DEGRADED" %}{% set why = "Degraded workers / supervisor" %}
              {% else %}{% set why = "Unknown" %}
              {% endif %}
              {% if why %}
                <div class="statusReason" title="{{ why }}">{{ why }}</div>
              {% endif %}
            {% endif %}

</div>
        </div>

        <div class="twoCols">
          <div class="mini">
            <div class="miniK">PnL Total ({% if r.funds_source == "REAL" %}REAL{% else %}SIM{% endif %}, {{ window|default("all") }})</div>
            <div class="miniV {% if pnl >= 0 %}pos{% else %}neg{% endif %} js-pnlTotal">${{ "%.2f"|format(pnl) }}</div>
            <div class="miniK js-pnlAvg" style="margin-top:6px;">Avg/trade: ${{ "%.2f"|format(pnl_avg) }}</div>
          </div>
          <div class="mini">
            <div class="miniK">Last Outcome (UTC)</div>
            <div class="miniV js-lastOutcome" style="font-size:13px; margin-top:10px;">{{ last_iso }}</div>
            <div class="miniK" style="margin-top:6px;">
              Updated: <span class="mono updatedAgo">—</span>
            </div>
          </div>
        </div>

        <div class="triple">
          <div class="stat">
            <div class="statK">Trades</div>
            <div class="statV js-trades">{{ trades }}</div>
          </div>
          <div class="stat">
            <div class="statK">Win Rate</div>
            <div class="statV js-winRate">{{ "%.2f"|format(win_pct) }}%</div>
          </div>
          <div class="stat">
            <div class="statK">Outcomes Age</div>
            <div class="statV mono">
              {% if trades|int > 0 and fresh is not none %}
                <span class="freshHuman js-freshHuman" data-sec="{{ fresh|float }}">—</span>
              {% else %}
                —
              {% endif %}
            </div>
          </div>
        </div>

        
        <div class="alertSpacer"></div>

<details>
          <summary>Details (debug + ops)</summary>
          <div class="chips">
            <span class="truthPill">Enabled: {{ "YES" if enabled else "NO" }}</span>
            <span class="truthPill">AI Stack: {{ "ON" if (r.get("enable_ai_stack")) else "OFF" }}</span>
<span class="truthPill">Workers Running: {{ r.get('workers_running') if r.get('workers_running') is not none else 0 }}</span>
            {% if dead_count > 0 %}
{% endif %}
            {% if r.funds_source == "REAL" %}
              <span class="chip">Balance: ${{ "%.2f"|format(r.balance or 0.0) }}</span>
            {% else %}
              <span class="chip">Balance: — (SIM)</span>
            {% endif %}

</div>
          <div class="footer">
            <div class="dim">Truth: <span class="mono">hydrate_dashboard_rows(window={{ window|default("all") }})</span></div>
            <div class="dim">Last: <span class="mono">{{ last_iso }}</span></div>
          </div>
        </details>
      </div>
    {% endfor %}
  </div>

  <script>
    function humanSec(sec){
      sec = Math.max(0, Math.floor(Number(sec||0)));
      const d = Math.floor(sec / 86400); sec -= d*86400;
      const h = Math.floor(sec / 3600); sec -= h*3600;
      const m = Math.floor(sec / 60); sec -= m*60;
      const parts = [];
      if (d) parts.push(d+'d');
      if (h) parts.push(h+'h');
      if (m) parts.push(m+'m');
      if (!parts.length) parts.push(sec+'s');
      else if (sec && parts.length < 3) parts.push(sec+'s');
      return parts.join(' ');
    }

    function copyText(txt){
      try{
        navigator.clipboard.writeText(txt);
      } catch(e){
        const ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
    }

    const pageLoadedAt = Date.now();
    function tickUpdated(){
      const agoSec = Math.floor((Date.now() - pageLoadedAt)/1000);
      document.getElementById('lastRefresh').textContent = new Date(pageLoadedAt).toLocaleTimeString();
      document.querySelectorAll('.updatedAgo').forEach(el=> el.textContent = humanSec(agoSec) + ' ago');
    }

    function renderFresh(){
      document.querySelectorAll('.freshHuman').forEach(el=>{
        const sec = Number(el.getAttribute('data-sec')||0);
        el.textContent = humanSec(sec);
      });
    }

    function applySearchSort(){
      const q = (document.getElementById('searchBox').value||'').toLowerCase().trim();
      const sortBy = document.getElementById('sortBy').value;
      const grid = document.getElementById('cardsGrid');
      const cards = Array.from(grid.querySelectorAll('.card'));

      cards.forEach(c=>{
        const hay = [
          c.getAttribute('data-acct')||'',
          c.getAttribute('data-strat')||'',
          c.getAttribute('data-role')||'',
          c.getAttribute('data-status')||''
        ].join(' ').toLowerCase();
        c.style.display = (q==='' || hay.includes(q)) ? '' : 'none';
      });

      const visible = cards.filter(c=>c.style.display !== 'none');

      const statusRank = (s)=>{
        s = (s||'').toUpperCase();
        if (s==='OFFLINE') return 0;
        if (s==='DEGRADED') return 1;
        if (s==='ONLINE') return 2;
        if (s==='STOPPED') return 3;
        return 4;
      };

      visible.sort((a,b)=>{
        if (sortBy==='acct'){
          return String(a.getAttribute('data-acct')).localeCompare(String(b.getAttribute('data-acct')));
        }
        if (sortBy==='status'){
          return statusRank(a.getAttribute('data-status')) - statusRank(b.getAttribute('data-status'));
        }
        if (sortBy==='freshness'){
          return Number(b.getAttribute('data-fresh')||0) - Number(a.getAttribute('data-fresh')||0);
        }
        if (sortBy==='pnl'){
          return Number(b.getAttribute('data-pnl')||0) - Number(a.getAttribute('data-pnl')||0);
        }
        if (sortBy==='trades'){
          return Number(b.getAttribute('data-trades')||0) - Number(a.getAttribute('data-trades')||0);
        }
        return 0;
      });

      visible.forEach(c=>grid.appendChild(c));
    }

    document.getElementById('searchBox').addEventListener('input', applySearchSort);
    document.getElementById('sortBy').addEventListener('change', applySearchSort);

    renderFresh();
    tickUpdated();
    applySearchSort();
    setInterval(tickUpdated, 1000);
    
    // Theme toggle (persist in localStorage)
    (function(){
      const key = "fb_theme";
      const root = document.documentElement;
      const btn = document.getElementById("themeToggle");
      if(!btn) return;

      function applyTheme(t){
        const theme = (t === "dark") ? "dark" : "light";
        root.setAttribute("data-theme", theme);
        btn.textContent = (theme === "dark") ? "Light" : "Dark";
        try{ localStorage.setItem(key, theme); } catch(e){}
      }

      let saved = "light";
      try{ saved = localStorage.getItem(key) || "light"; } catch(e){}
      applyTheme(saved);

      btn.addEventListener("click", function(){
        const cur = root.getAttribute("data-theme") || "light";
        applyTheme(cur === "dark" ? "light" : "dark");
      });
    })();


    // hard refresh disabled (Step 21)
  

    /* SOFT REFRESH (Step 21)
       - Pull JSON from /api/subaccounts
       - Update existing DOM nodes in place
       - Preserve search + sort + scroll
    */
    async function softRefresh(){
      try{
        const windowParam = "{{ window|default('all') }}";
        const [subsResp, metaResp] = await Promise.all([
          fetch(`/api/subaccounts?window=${encodeURIComponent(windowParam)}`, { cache: "no-store" }),
          fetch(`/api/dashboard_meta?window=${encodeURIComponent(windowParam)}`, { cache: "no-store" })
        ]);

        if(!subsResp.ok) return;
        const rows = await subsResp.json();

        // Summary recompute from rows (mirror server logic)
        let acctCount=0, onlineCount=0, totalTrades=0, pnlSum=0, staleCount=0, deadCount=0, simCount=0;

        for(const r of rows){
          if(!r || !r.account_label) continue;
          acctCount++;
          if(r.is_online) onlineCount++;
          totalTrades += Number(r.total_trades||0);
          pnlSum += Number(r.pnl_usd_total||0);

          const f = (r.outcomes_freshness_sec===null || r.outcomes_freshness_sec===undefined) ? null : Number(r.outcomes_freshness_sec);
          if(f!==null && f>3600) staleCount++;
          if(f!==null && f>86400) deadCount++;

          const m = String(r.automation_mode||"").toUpperCase();
          if(!m.includes("LIVE")) simCount++;
        }

        const elTotalTrades = document.getElementById("sumTotalTrades");
        if(elTotalTrades) elTotalTrades.textContent = String(totalTrades);

        const elPnl = document.getElementById("sumPnlTotal");
        if(elPnl){
          elPnl.textContent = "$" + pnlSum.toFixed(2);
          elPnl.classList.toggle("pos", pnlSum>=0);
          elPnl.classList.toggle("neg", pnlSum<0);
        }

        const elOnline = document.getElementById("sumOnlineTotal");
        if(elOnline) elOnline.textContent = `${onlineCount} / ${acctCount}`;

        const elStaleDead = document.getElementById("sumStaleDead");
        if(elStaleDead) elStaleDead.textContent = `${staleCount} / ${deadCount}`;

        const elSim = document.getElementById("sumSimCards");
        if(elSim) elSim.textContent = String(simCount);

        // Update per-card fields
        const byAcct = new Map(rows.map(r => [String(r.account_label), r]));

        document.querySelectorAll(".card").forEach(card=>{
          const acct = card.getAttribute("data-acct");
          if(!acct || !byAcct.has(acct)) return;
          const r = byAcct.get(acct);

          // Update attributes used by sort
          const pnl = Number(r.pnl_usd_total||0);
          const trades = Number(r.total_trades||0);
          const fresh = (r.outcomes_freshness_sec===null || r.outcomes_freshness_sec===undefined) ? 0 : Number(r.outcomes_freshness_sec);

          card.setAttribute("data-pnl", String(pnl));
          card.setAttribute("data-trades", String(trades));
          card.setAttribute("data-fresh", String(fresh));

          // Status badge
          const status = String(r.status||"").toUpperCase();
          const statusEl = card.querySelector(".js-status");
          if(statusEl){
            // Prefer server normalized: ONLINE/OFFLINE etc
            statusEl.textContent = String(card.getAttribute("data-status")||statusEl.textContent);
          }

          // Strategy/Role chips
          const stratEl = card.querySelector(".js-strategy");
          if(stratEl) stratEl.textContent = "Strategy: " + String(r.strategy||"unknown");

          const roleEl = card.querySelector(".js-role");
          if(roleEl){
            const role = String(r.role||"").trim();
            roleEl.textContent = "Role: " + role;
          }

          // Mode badge
          const modeEl = card.querySelector(".js-mode");
          if(modeEl) modeEl.textContent = String(r.automation_mode||"").toUpperCase();

          // PnL fields
          const pnlEl = card.querySelector(".js-pnlTotal");
          if(pnlEl){
            pnlEl.textContent = "$" + pnl.toFixed(2);
            pnlEl.classList.toggle("pos", pnl>=0);
            pnlEl.classList.toggle("neg", pnl<0);
          }

          const pnlAvg = Number(r.pnl_usd_avg||0);
          const pnlAvgEl = card.querySelector(".js-pnlAvg");
          if(pnlAvgEl) pnlAvgEl.textContent = "Avg/trade: $" + pnlAvg.toFixed(2);

          // Last outcome
          const lastEl = card.querySelector(".js-lastOutcome");
          if(lastEl) lastEl.textContent = String(r.outcomes_last_ts_iso||"—");

          // Trades / Win
          const tradesEl = card.querySelector(".js-trades");
          if(tradesEl) tradesEl.textContent = String(trades);

          const winEl = card.querySelector(".js-winRate");
          if(winEl){
            const winPct = Number(r.win_rate_pct||0);
            winEl.textContent = winPct.toFixed(2) + "%";
          }

          // Freshness
          const freshEl = card.querySelector(".js-freshHuman");
          if(freshEl){
            freshEl.setAttribute("data-sec", String(fresh));
            freshEl.textContent = humanSec(fresh);
          }
        });

        // Preserve current filters
        applySearchSort();
        tickUpdated();

      } catch(e){
        // fail-soft: do nothing
      }
    }

    // Replace the old hard reload with soft refresh every 4s
    setInterval(softRefresh, 4000);

</script>
</body>
</html>
